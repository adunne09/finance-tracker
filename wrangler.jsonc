{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "household-finances-local",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist/public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "household-finances-local", "database_id": "local-only", "migrations_dir": "migrations" }],
  "vars": { "LOCAL_DEV": "true" },
  "triggers": { "crons": ["17 * * * *"] }
}
