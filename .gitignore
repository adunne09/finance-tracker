# Only reviewed application source belongs in this public repository.
/*
!/.gitignore
!/README.md
!/package.json
!/pnpm-lock.yaml
!/tsconfig.json
!/.oxlintrc.json
!/.npmrc
!/.env.example
!/build.mjs
!/install-hooks.mjs
!/lefthook.yml
!/alchemy.run.ts
!/AGENTS.md
!/src/
!/public/
!/migrations/
!/tools/

# Always private, including inside otherwise permitted source directories.
**/.env
**/.env.*
!/.env.example
**/.dev.vars*
**/node_modules/
**/dist/
**/.private/
**/.data/
**/.wrangler/
**/.alchemy/
**/*.csv
**/*.pdf
**/*.qfx
**/*.qbo
**/*.xlsx
**/*.zip
**/*.sqlite*
**/*.db
**/*.log
**/*.har
**/.DS_Store
